# Copy to .env if you want to try live Gemini. Never put a key in here.
# Live Gemini uses the stored custom.gemini credential via its helper —
# no API key is needed in this file, in env, or in chat.
# GEMINI_LIVE=1 tries one live Gemini call per incident (helper at
# ~/workspace/custom-connectors/custom.gemini/bin/client.py).
# Default (unset or 0) is the deterministic mock investigator, so the
# demo works with no key and no network call.
GEMINI_LIVE=0
GEMINI_MODEL=gemini-3.8-flash
