# Copy to .env if you want to try live Gemini. Never put a real key in
# a file that gets committed — .env is gitignored; .env.example stays
# blank on purpose.
#
# Two ways the investigator reaches live Gemini (GEMINI_LIVE=1):
#  1. GEMINI_API_KEY set (env var, or Render dashboard > Environment):
#     the backend calls the Gemini REST API directly with it. This is
#     the only live path on Render — the helper below does not exist
#     there. Leave blank to stay on the mock.
#  2. No key set, running on this machine: the stored custom.gemini
#     credential is used via its helper
#     (~/workspace/custom-connectors/custom.gemini/bin/client.py).
#
# Default (GEMINI_LIVE unset or 0) is the deterministic mock
# investigator, so the demo works with no key and no network call.
GEMINI_API_KEY=
GEMINI_LIVE=0
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Postgres persistence: set DATABASE_URL to a Postgres
# connection string (Render dashboard > Environment, or Supabase) and
# incidents + the audit trail survive restarts. Unset = in-memory,
# exactly as before. Never commit a real connection string here.
DATABASE_URL=
